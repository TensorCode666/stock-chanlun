# DeepSeek API（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型 ID，诊股与策略 LLM 默认使用 V4 Pro
# DEEPSEEK_MODEL_ID=deepseek-v4-pro

# Gemini API（https://ai.google.dev）
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 逗号分隔的前端源；默认 *（此时浏览器 Cookie 凭证跨域关闭）
# CORS_ORIGINS=http://localhost:5173,https://yourname.github.io

# 仅在东方财富等接口 SSL/代理异常时设为 1（默认校验证书）
# FINANCE_TLS_RELAXED=0

# 后端监听端口（run_server.py 与 python main.py 均读取，默认 8010）
# PORT=8010

# 选股缠论并发线程数（默认 12）
# SCREENING_WORKERS=12

# 仅在可信反向代理（Railway/nginx 等会覆盖 X-Forwarded-For）之后设为 1，
# 否则客户端可伪造该头绕过每 IP 限流。默认 0（信任直连 socket IP）。
# TRUST_X_FORWARDED_FOR=0
